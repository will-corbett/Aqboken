{
  "name": "korti",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Learn and practise Kazakh: grammar explained, instant drills and vocabulary by theme.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "data:fetch": "mkdir -p data-raw && curl -sSL -o data-raw/kaikki-kazakh.jsonl https://kaikki.org/dictionary/Kazakh/kaikki.org-dictionary-Kazakh.jsonl",
    "data:check": "tsx scripts/check-wiktionary.ts",
    "audio:texts": "tsx scripts/audio-texts.ts",
    "audio:tts": "npm run audio:texts && python3 scripts/tts.py data-raw/piper",
    "audio:native": "tsx scripts/fetch-recordings.ts",
    "data:fetch-tatoeba": "mkdir -p data-raw/tatoeba && for f in kaz/kaz_sentences_detailed.tsv.bz2 kaz/kaz-eng_links.tsv.bz2 eng/eng_sentences.tsv.bz2; do curl -sSfL -o data-raw/tatoeba/$(basename $f) https://downloads.tatoeba.org/exports/per_language/$f; done",
    "data:sentences": "tsx scripts/build-sentences.ts",
    "review": "tsx scripts/review-report.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "^22.20.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/pt-sans": "^5.3.0",
    "@fontsource/pt-serif": "^5.3.0"
  }
}
